
linmot_ctrl: &linmot_ctrl
  inputs:
    position: { kp: 0.5, kd: 0.001, filter: 200, target: current, pd: inputs, field_name: Actual Position, scale: 1E-10 } 
    torque: { kp: 0.02, kd: 0.0008, filter: 100, target: current, pd: inputs, field_name: Actual Torque,   scale: 1E-6 }
  outputs:
    current: { kt: 0.1, pd: outputs, name: Command Current, scale: 1E-3 }

modules:
- name: my_current_control
  so_file: libmodule_current_control.so
  config: 
    controllers:
    - { <<: *linmot_ctrl, name: linmot_0, pd_map: { inputs: ecat.slave_0.inputs.pd, outputs: ecat.slave_0.outputs.pd } }
    - { <<: *linmot_ctrl, name: linmot_1, pd_map: { inputs: ecat.slave_1.inputs.pd, outputs: ecat.slave_1.outputs.pd } }
    - { <<: *linmot_ctrl, name: linmot_2, pd_map: { inputs: ecat.slave_2.inputs.pd, outputs: ecat.slave_2.outputs.pd } }
    - { <<: *linmot_ctrl, name: linmot_3, pd_map: { inputs: ecat.slave_3.inputs.pd, outputs: ecat.slave_3.outputs.pd } }
    - { <<: *linmot_ctrl, name: linmot_4, pd_map: { inputs: ecat.slave_4.inputs.pd, outputs: ecat.slave_4.outputs.pd } }

